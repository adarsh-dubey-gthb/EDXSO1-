# ==============================================================================
# Micro-Influencer Outreach System - Environment Configuration
# ==============================================================================

# LLM Providers (Optional - fallback offline synthesizer runs automatically if omitted)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# YouTube Data API v3 (Optional - uses curated 55+ real influencer seed dataset if omitted)
YOUTUBE_API_KEY=

# Outreach Sending Mode
# Set to 'true' to safely simulate email dispatching without real mail servers
SIMULATION_MODE=true

# Live SMTP Configuration (Required only if SIMULATION_MODE=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_NAME=DevPulse Outreach Team

# Automation Workflow Integration (Optional - n8n / Make / Zapier)
# Enter your n8n or Zapier webhook URL to forward outreach payloads automatically
N8N_WEBHOOK_URL=
